{
  "name": "CalculadoraTattoo - Gestão de Estoque e Orçamento",
  "short_name": "CalculadoraTattoo",
  "description": "PWA para gestão profissional de estoque e orçamento para estúdios de tatuagem",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#2D0B40",
  "background_color": "#ffffff",
  "orientation": "portrait-primary",
  
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "categories": ["productivity", "business"],
  "screenshots": [
    {
      "src": "icons/screenshot-mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],

  "shortcuts": [
    {
      "name": "Novo Orçamento",
      "short_name": "Orçamento",
      "description": "Criar um novo orçamento de tatuagem",
      "url": "/?screen=budget",
      "icons": [
        {
          "src": "icons/shortcut-budget.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Estoque",
      "short_name": "Estoque",
      "description": "Gerenciar itens de estoque",
      "url": "/?screen=inventory",
      "icons": [
        {
          "src": "icons/shortcut-inventory.png",
          "sizes": "96x96"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backup",
          "accept": ["application/json", ".json"]
        }
      ]
    }
  },

  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "application/json": [".json"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-new", "navigate-existing", "auto"]
  },

  "prefer_related_applications": false,
  "related_applications": []
}
