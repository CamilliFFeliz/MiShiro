{
  "id": "./index.html",
  "name": "MiShiro Orçamentos",
  "short_name": "MiShiro",
  "description": "PWA offline para controle de estoque, cálculo de custos e criação de orçamentos para estúdios de tatuagem.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0F0A18",
  "theme_color": "#2D0B40",
  "categories": ["business", "productivity", "finance"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Abrir estoque",
      "short_name": "Estoque",
      "description": "Abrir o estoque de insumos.",
      "url": "./index.html#inventory",
      "icons": [{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Criar orçamento",
      "short_name": "Orçamento",
      "description": "Abrir a tela de orçamento.",
      "url": "./index.html#budget",
      "icons": [{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
